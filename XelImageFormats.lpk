<?xml version="1.0" encoding="UTF-8"?>
<CONFIG>
  <Package Version="5">
    <Name Value="XelImageFormats"/>
    <Author Value="Xelitan.com"/>
    <CompilerOptions>
      <Version Value="11"/>
      <SearchPaths>
        <IncludeFiles Value="jbig2;bpg;flif;heic"/>
        <OtherUnitFiles Value="jbig2;jpeg2000;jpeg-xl;jpeg-xl/brotli;lepton;svg;webp;bpg;flif;heic;other;formats"/>
        <UnitOutputDirectory Value="lib/$(TargetCPU)-$(TargetOS)"/>
      </SearchPaths>
    </CompilerOptions>
    <Description Value="Native FPC/Lazarus decoders/encoders for 51 formats: JBIG2, JPEG 2000, JPEG XL, Lepton, HEIC, BPG, SVG, WebP, TIFF, PSD, FAX, PSP, DDS, BMP, ICO, ANI, CUR, WMF, EMF, CIN, CEL, MNG, JNG, PNG, PPM, PCD, PFM, PAM, HDR, FITS, RAW, TGA, PCX, QOI and more.  

Installing this package registers all these formats with TPicture (.jb2, .jp2, .jxl, .lep, .svg, .webp, .bpg and more), so LoadFromFile/SaveToFile work out of the box."/>
    <License Value="See per-subdirectory LICENSE files (Apache-2.0, MIT, JasPer-2.0)."/>
